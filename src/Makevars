CXX_STD = CXX17

PKG_CPPFLAGS = -I. -I./include -I./include/external -I./include/external/edlib/include \
               -DSTRICT_R_HEADERS -DBUILDING_R_PACKAGE

PKG_CXXFLAGS = -O3 $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS     = ssw.o edlib.o -lz $(SHLIB_OPENMP_CXXFLAGS)

# Build the vendored SSW (C) and edlib (C++) translation units into
# objects linked with the rest of the package.
$(SHLIB): ssw.o edlib.o

ssw.o: include/external/ssw/ssw.c include/external/ssw/ssw.h
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -c $< -o $@

edlib.o: include/external/edlib/src/edlib.cpp include/external/edlib/include/edlib.h
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -c $< -o $@
